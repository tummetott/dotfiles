# vim: set ft=ini:

{{ if eq .chezmoi.hostname "Catch" -}}
# Catch defaults to the SRLabs identity
[include]
    path = ~/.config/git/config-srlabs

# Tummetott repositories use the private profile
[includeIf "hasconfig:remote.*.url:git@github.com:tummetott/**"]
    path = ~/.config/git/config-tummetott

# Switch this repository's Git identity and SSH key on demand.
# To update the author of the latest commit after switching:
# git commit --amend --no-edit --reset-author
[alias]
    use-private = "!git config --local include.path ~/.config/git/config-tummetott"
    use-work = "!git config --local include.path ~/.config/git/config-srlabs"

{{- else }}
# Other machines use the Tummetott identity
[include]
    path = ~/.config/git/config-tummetott
{{- end }}

[pull]
    rebase = false

[color]
    ui = auto

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff2
