# vim: set ft=gitconfig:

[include]
{{- if has .chezmoi.hostname (list "Catch" "big-fuzz" "fuzzy-bear") }}
    path = ~/.config/git/config-srlabs
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/config-srlabs-gh
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/config-srlabs-gh
{{- else }}
    path = ~/.config/git/config-tummetott
{{- end }}

[includeIf "hasconfig:remote.*.url:git@github.com:[tT]ummetott/**"]
    path = ~/.config/git/config-tummetott
[includeIf "hasconfig:remote.*.url:https://github.com/[tT]ummetott/**"]
    path = ~/.config/git/config-tummetott

[url "git@github-private:tummetott/"]
    insteadOf = git@github.com:tummetott/
    insteadOf = git@github.com:Tummetott/
    pushInsteadOf = https://github.com/tummetott/
    pushInsteadOf = https://github.com/Tummetott/

# Switch this repository's commit identity on demand.
# To update the author of the latest commit after switching:
# git commit --amend --no-edit --reset-author
[alias]
    use-private = "!git config --local include.path ~/.config/git/config-tummetott"
    use-work = "!git config --local include.path ~/.config/git/config-srlabs"

[pull]
    rebase = false

[color]
    ui = auto

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff2
