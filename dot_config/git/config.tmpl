# vim: set ft=ini:

{{ if eq .chezmoi.hostname "Catch" -}}
[include]
    path = ~/.config/git/config-srlabs

[includeIf "hasconfig:remote.*.url:git@github.com-private:*/**"]
    path = ~/.config/git/config-tummetott

{{- else }}
[include]
    path = ~/.config/git/config-tummetott
{{- end }}

[pull]
    rebase = false

[color]
    ui = auto

[diff]
    tool = nvimdiff

[merge]
    tool = nvimdiff2
