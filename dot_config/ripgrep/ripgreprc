# Don't let ripgrep vomit really long lines to my terminal, and show a preview.
--max-columns=110
--max-columns-preview

# Show line numbers
--line-number

# Show hidden files
--hidden

# Follow symlinks
--follow

# Enable smart case. Case is ignored except an uppercase letter is typed
--smart-case

# Exclude files while searching
--glob=!.git
--glob=!.DS_Store
--glob=!._*

# Set colours. The 256 colours are defined by alacritty
--colors=path:fg:cyan
--colors=line:fg:yellow
