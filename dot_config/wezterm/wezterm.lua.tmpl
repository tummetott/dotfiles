-- vim: set ft=lua:

local function read_file(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local s = f:read("*l")
    f:close()
    return s
end

local function current_tinty_scheme()
    local path = os.getenv("HOME") .. "/.local/share/tinted-theming/tinty/artifacts/current_scheme"
    local s = read_file(path)
    if not s or s == "" then return end
    return s
end

local wezterm = require 'wezterm'
local config = {}

-- The default term is 'xterm-256color'. I could change that to wezterms own
-- terminfo with the following cmd:
-- config.term = 'wezterm'
config.font = wezterm.font 'FiraCode Nerd Font Mono'
---@diagnostic disable-next-line: malformed-number
config.font_size = {{ .platform.fontsize }}
config.enable_tab_bar = false
config.audible_bell = 'Disabled'
config.color_scheme = current_tinty_scheme() or 'tokyonight'
config.enable_kitty_keyboard = true
-- Prevents GNOME from showing wezterm without a border and close/minimize buttons.
config.enable_wayland = false
config.debug_key_events = false
config.keys = {
    -- Disable some default keymaps that collide with zellij.
    -- NOTE: With SHIFT in `mods`, WezTerm expects the shifted character as `key`
    -- (e.g. `{` instead of `[`, `+` instead of `=`).
    { key = "=", mods = "CTRL", action = wezterm.action.DisableDefaultAssignment },
    { key = "H", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "L", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "J", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "K", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "T", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "W", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "Q", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "Z", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "N", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "P", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "F", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "X", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "M", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "R", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "U", mods = "CTRL|SHIFT", action = wezterm.action.DisableDefaultAssignment },
    { key = "Tab", mods = "CTRL", action = wezterm.action.DisableDefaultAssignment },

    -- HACK: WezTerm supports the Kitty keyboard protocol (KKP), but some key
    -- combinations do not emit the correct CSI-u sequences under KKP (zellij).
    -- These send the expected sequences explicitly.
    { key = "-", mods = "CTRL", action = wezterm.action.SendString("\x1b[45;5u") },
    { key = "+", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[61;6u"), },
    { key = "{", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[91;6u") },
    { key = "}", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[93;6u") },

    -- HACK: Programs without KKP (tmux) get xterm modifyOtherKeys encoding,
    -- where WezTerm drops or folds the modifiers of these combinations. These
    -- send the KKP sequences instead, which tmux parses as well. Under KKP they
    -- match WezTerm's own encoding. Ctrl+Shift+number follows the same pattern,
    -- see the loop below the table.
    { key = "_", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[45;6u") },
    { key = "?", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[47;6u") },
    { key = ":", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[59;6u") },
    { key = ";", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[59;6u") },
    { key = "phys:Space", mods = "CTRL|SHIFT", action = wezterm.action.SendString("\x1b[27;6;32~") },
    { key = "1", mods = "CMD", action = wezterm.action.SendString("\x1b[49;9u") },
    { key = "2", mods = "CMD", action = wezterm.action.SendString("\x1b[50;9u") },
    { key = "3", mods = "CMD", action = wezterm.action.SendString("\x1b[51;9u") },
    { key = "4", mods = "CMD", action = wezterm.action.SendString("\x1b[52;9u") },
    { key = "5", mods = "CMD", action = wezterm.action.SendString("\x1b[53;9u") },
    { key = "6", mods = "CMD", action = wezterm.action.SendString("\x1b[54;9u") },
    { key = "7", mods = "CMD", action = wezterm.action.SendString("\x1b[55;9u") },
    { key = "8", mods = "CMD", action = wezterm.action.SendString("\x1b[56;9u") },
    { key = "9", mods = "CMD", action = wezterm.action.SendString("\x1b[57;9u") },

    -- These are conventional macOS keymaps
    { key = 'f', mods = 'CMD|CTRL', action = wezterm.action.ToggleFullScreen },
    { key = 'h', mods = 'CMD', action = wezterm.action.HideApplication },

    -- fn+<del> should delete
    { key = "Delete", mods = "NONE", action = wezterm.action.SendString("\x1b[3~") },
}

-- Ctrl+Shift+number sends the KKP sequence, like the modifyOtherKeys group in
-- the table. WezTerm's default tab bindings use the digit and the shifted
-- symbol, with and without SHIFT, so all three forms are mapped.
for i, symbol in ipairs({ "!", "@", "#", "$", "%", "^", "&", "*", "(" }) do
    local send = wezterm.action.SendString(string.format("\x1b[%d;6u", 48 + i))
    table.insert(config.keys, { key = tostring(i), mods = "CTRL|SHIFT", action = send })
    table.insert(config.keys, { key = symbol, mods = "CTRL|SHIFT", action = send })
    table.insert(config.keys, { key = symbol, mods = "CTRL", action = send })
end

return config
