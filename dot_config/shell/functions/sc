# vim: set ft=bash:

# Shell crush: Ask crush for a single shell one-liner, no explanation, no markdown.
# TODO: https://github.com/charmbracelet/crush/issues/3621

function sc {
    crush run --quiet -m openrouter/openai/gpt-5.6-luna "You are a shell expert. Output ONLY a single-line shell command that solves the task below. Do not explain anything. Do not use markdown, backticks or code fences. Task: $*"
}
