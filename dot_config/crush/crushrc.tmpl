# vim: set ft=bash:

model large openai/gpt-5.6-terra
model small openai/gpt-5.6-luna

option global-context-path ~/.config/crush/instructions.md
option ui transparent true
option metrics false
# option provider-auto-update true

permissions allow \
    fetch \
    agentic_fetch \
    sourcegraph

# Add srlabs provider only when inside the srlabs VPN
{{ if eq .chezmoi.os "darwin" -}}
if route -n get 10.10.45.86 2>/dev/null | grep -q 'interface: utun'; then
{{ else if eq .chezmoi.os "linux" -}}
if command -v ip >/dev/null && ip route get 10.10.45.86 2>/dev/null | grep -qE 'dev tun[0-9]*'; then
{{ end }}  provider add srlabs \
    --type openai-compat \
    --base-url "http://10.10.45.86:8080/v1" \
    --discover-models true
fi
