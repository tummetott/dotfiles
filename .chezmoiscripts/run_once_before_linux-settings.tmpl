#!/usr/bin/env bash
# vim: set ft=bash:

source ~/.local/share/chezmoi/.script-helper
set -euo pipefail
trap on_error ERR

{{ if eq .chezmoi.os "linux" }}
{{ if .platform.hostname }}
info 'Set computer name'
sudo hostnamectl set-hostname {{ .platform.hostname | quote }}
{{ end }}

# Git is a dependency for chezmoi external sources, so apt systems install it
# before externals are downloaded.
{{ if .platform.apt }}
if ! has git; then
    info 'Installing git'
    log sudo apt-get -q update
    log sudo apt-get -qy install git
fi

info 'Generate locale'
# Some images (e.g. Raspberry Pi OS) only enable a different default locale in
# /etc/locale.gen, in which case 'locale-gen en_US.UTF-8' silently generates
# nothing. Uncomment the line first so generation always includes it.
log sudo sed -i 's/^# *\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen
log sudo locale-gen "en_US.UTF-8"
{{ end }}
{{ end }}
